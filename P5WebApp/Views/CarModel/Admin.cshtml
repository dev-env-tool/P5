@using P5WebApp.Models.ViewModels
@Html.ValidationSummary()


@model IEnumerable<P5WebApp.Models.ViewModels.CarModelViewModel>

@{
    ViewData["Title"] = "Gestion des modèles (administrateur)";
    Layout = "_Layout";
}

<h1>Gestion des modèles</h1>

<br />
<div id="panel-body">
    <table class="table table-bordered table-striped table-sm">
        <thead>
            <tr>
                <th>
                    <label>Nom du modèle</label>
                </th>
                <th>
                    <label>Modifier</label>
                </th>
                <th>
                    <label>Supprimer</label>
                </th>
        </thead>
        <tbody>
            @foreach (CarModelViewModel c in Model)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>
                        
                            <form id="@c.Name" asp-action="Edit" asp-controller="CarModel" method="get">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn-custom btn btn-danger">Modifier
                                </button>
                            </form>
                    </td>
                    <td>
                        
                            <form id="@c.Id" asp-action="Delete" asp-controller="CarModel" method="post">
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="btn-custom btn btn-danger">Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div style="white-space:pre-line">
        <h1></h1>
    </div>
    <a class="btn btn-primary btn-custom" asp-controller="CarModel" asp-action="Create">Créer</a>
</div>
@section Scripts {
    <script src="@Url.Content("~/js/test.js")"></script>
}