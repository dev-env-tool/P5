@using P5WebApp.Models.ViewModels
@Html.ValidationSummary()


@model IEnumerable<P5WebApp.Models.ViewModels.BrandViewModel>

@{
    ViewData["Title"] = "Gestion des marques (administrateur)";
    Layout = "_Layout";
}

<br />
<div id="panel-body">
    <table class="table table-bordered table-striped table-sm">
        <thead>
            <tr>
                <th>
                    <label>Nom de la Marque</label>
                </th>
                <th>
                    <label>Modifier</label>
                </th>
                <th>
                    <label>Supprimer</label>
                </th>
        </thead>
        <tbody>
            @foreach (BrandViewModel b in Model)
            {
                <tr>
                    <td>@b.BrandName</td>
                    <td>
                        
                            <form id="@b.BrandName" asp-action="Edit" asp-controller="Brand" method="get">
                                <input type="hidden" name="id" value="@b.BrandId" />
                                <button type="submit" class="btn-custom btn btn-danger">Modifier
                                </button>
                            </form>
                    </td>
                    <td>
                        
                        <form id="@b.BrandName" asp-action="Delete" asp-controller="Brand" method="post">
                            <input type="hidden" name="id" value="@b.BrandId" />
                            <button type="submit" class="btn-custom btn btn-danger">Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div style="white-space:pre-line">
        <h1></h1>
    </div>
    <a class="btn btn-primary btn-custom" asp-controller="Brand" asp-action="Create">Créer</a>
</div>
@section Scripts {
    <script src="@Url.Content("~/js/test.js")"></script>
}