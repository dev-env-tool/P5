@model P5WebApp.Models.ViewModels.BrandViewModel

@{
    Layout = "_Layout";
}



<div class="row">
    <h1 class="mb-3 col-4 offset-md-4">
        Modification d'une marque
    </h1>
    <div style="white-space:pre-line">
        <h1></h1>
    </div>
    <form method="post">
        <input type="hidden" name="BrandId" value="@Model.BrandId" />
        <div class="mb-3 col-4 offset-md-4">
            <div class="mb-3 col-4">
                <label>Nom de marque*:</label>
            </div>
            <input asp-for="BrandName" class="form-control col-12" /><span asp-validation-for="BrandName"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="row">
                <button type="submit" class="btn btn-custom col-12">Modifier</button>
            </div>
        </div>
    </form>
</div>






@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}