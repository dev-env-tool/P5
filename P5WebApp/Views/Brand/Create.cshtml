@model P5WebApp.Models.ViewModels.BrandViewModel

@{
    ViewData["Title"] = "Création des marques (administrateur)";
    Layout = "_Layout";
}

<form asp-action="Create" method="post">
    <div class="mb-3 col-6">
        <div asp-validation-summary="All" class="text-danger"></div>
    </div>

    <div class="mb-3 col-6">
        <label>Nom de marque*:</label><input asp-for="BrandName" class="form-control" />
        <div><span asp-validation-for="BrandName" class="text-danger"></span></div>
    </div>

</form>
<div style="white-space:pre-line">
    <h1></h1>
</div>
<a class="btn btn-primary btn-custom" asp-action="Create" asp-controller="Brand">Créer</a>
