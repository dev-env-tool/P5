@model P5WebApp.Models.ViewModels.ShortAddViewModel
@using P5WebApp.Models.Entities


@{
    Layout = "_Layout";
    var fixes = ViewBag.Fixes as List<Fix>;
    var vinCodes = ViewBag.CarVinCodes as List<Car>;
    var carInfos = ViewBag.CarInfos;
}


<div class="row">
    <h1 class="mb-3 col-4 offset-md-4">
        Création d'une annonce
    </h1>
    <div style="white-space:pre-line">
        <h1></h1>
    </div>
    <form method="post">
        <input type="hidden" name="ShortAddId" value="@Model.ShortAddId" />
        <div class="mb-3 col-4 offset-md-4">
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Description*:</label>
            </div>
            <input asp-for="Description" class="form-control col-12" />
            <span asp-validation-for="Description"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Date de disponibilité*':</label>
            </div>
            <input asp-for="ShortAddAvailabilityDate" type="text" id="txtDate" class="form-control col-12" date="@Model.ShortAddAvailabilityDate" />
            <span asp-validation-for="ShortAddAvailabilityDate"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Publier l'annonce':</label>
            </div>
            <input asp-for="ShortAddBuyPrice" class="form-control navbar-toggler-icon col-12" />
            <span asp-validation-for="ShortAddBuyPrice"></span>








            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Date de vente:</label>
            </div>
            <input asp-for="ShortAddDateSold" type="text" id="txtDate2" class="form-control col-12" date="@Model.ShortAddDateSold" />
            <span asp-validation-for="ShortAddDateSold"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Voiture*:</label>
            </div>
            @Html.DropDownListFor(m => m.CarViewModel.SelectedVinCode,
                new SelectList(carInfos, "Value", "Text"), htmlAttributes: new {@class ="form-control col-12"})
            <span asp-validation-for="ShortAddCarId"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Prix d'achat*:</label>
            </div>
            <input asp-for="ShortAddBuyPrice" class="form-control col-12" />
            <span asp-validation-for="ShortAddBuyPrice"></span>




