            dataType: 'json',
            
            success: function(data) {
            console.log('data : ', data);
            $('#CarFinishTypeId').empty();
            $('#CarFinishTypeId').append($('<option>', {
            value: '',
            text: '-- Choisissez une finition --'
            }));
            $.each(data, function(index, model) {
