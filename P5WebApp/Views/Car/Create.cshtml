    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
            <script type="text/javascript">
                $(function()
                {
                    $("#txtDate").datepicker({format:"dd/mm/yyyy"});
                });
                $(function()
                {
                    $("#txtDate2").datepicker({format:"dd/mm/yyyy"});
                });
            </script>
            
            <script type="text/javascript">
            //display all error messages without any initial interaction
            $(document).ready(function() 
            {
                var form = $("#CarForm");
                form.validate();
                form.valid();
            });
            </script>


            <script type="text/javascript">
                $(document).ready(function() 
                {
                    var form = $("#CarForm");

                    // After an input change, check if form is valid.
                    // If there is another input change in less than 400ms then wait.
                    // Else, onto the next input change, checkField occurs.
                    let debounceTimer;
                    function debounceCheck() {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(checkFields, 400);
                    }
                    $("input[required]").on("input change", debounceCheck);

                    // After a blur action, check if form is valid.
                    setTimeout(checkFields, 100);
                    $("input[required]").on("blur", checkFields);

                    


                    function checkFields() 
                    {
                        let IsCarFormFilled = true;
                        $("input[required]:visible:not(:disabled)").each(function() {
                        if (!$(this).val() || $(this).val().trim() === "") {
                        IsCarFormFilled = false;
                        return false;
                        }
                        });

                        console.log("Form filled? ", IsCarFormFilled);

                        $("#IsCarFormFilled").text(IsCarFormFilled);
                        $("#CreateNewFixButton").prop('disabled', !IsCarFormFilled);
                        $("#DeleteLastFixButton").prop('disabled', !IsCarFormFilled);

                    }




                });
            </script>

            <script type="text/javascript">
            $(document).ready(function()
            {
                var container = $("#CreateFixDiv");
                var container2 = $("#CarForm");
                var createButton = $("#CreateNewFixButton")
                var deleteButton = $("#DeleteLastFixButton")
                var count = 0;

                if(count == 0)
                {
                    var fakeFix = $('#fix-fake-template').html();
                    container.append(fakeFix);
                }


                function addFix() 
                {
                    var templateForFix = $('#fix-template').html();
                    templateForFix = templateForFix.replace(/__index__/g,count);

                    container.append(templateForFix);
                    container.show();

                    var form = container2;
                    form.removeData('validator');
                    form.removeData('unobtrusiveValidation');
                    $.validator.unobtrusive.parse(form);

            

                    form.validate();
                    form.valid();

                    var lastFix = container.children(".fix").last();
                    // $.validator.unobtrusive.parse(lastFix);


                    // $.validator.unobtrusive.parse(container);


                    lastFix.find("input[type='date']").datepicker({ format: "dd/mm/yyyy" });
                    
                    
                }



                createButton.click(function(e)
                { 
                        var fakeFix = container.find(".fix:hidden");
                        if(fakeFix.length > 0) {
                            fakeFix.remove();
                            count = 0;
                        }
                        e.preventDefault();
                        console.log("clic button");
                        addFix(count);
                        console.log(count);
                        count++;
                        console.log(count);
                });


                function removeFix()
                {

                    var sectionToDelete = container.find(".fix").last();


                        console.log(count);
                        sectionToDelete.remove();
                        if(count==0)
                        {
                            container.hide();
                            container.empty();
                            var fakeFix = $('#fix-fake-template').html();
                            container.append(fakeFix);
                            count = 0;
                        }
                        else
                        {
                        count--;
                        console.log(count, "ici");
                        container2.removeData("validator");
                        container2.removeData("unobtrusiveValidation");
                        $.validator.unobtrusive.parse(container2);

                        }
                }
                deleteButton.click(function(e)
                {
                    e.preventDefault();
                    console.log("clic button2");
                    removeFix(count);
                    console.log(count);
                });


            });
            </script>

            
            <script type="text/template" id="fix-fake-template">
                <div class="fix" style="display:none;">
                <input type="hidden" name="CarFixesViewModelList[0].FixId" value="0" />
                <input type="hidden" name="CarFixesViewModelList[0].AssociatedCarId" value=@Model.CarId />
                <input type="text" name="CarFixesViewModelList[0].FixDescription" value="dummyfix1900" />
                <input type="date" name="CarFixesViewModelList[0].FixDate" value="1900-01-01" />
                <input type="text" name="CarFixesViewModelList[0].FixCost" value="1" />
                </div>
            </script>


            <script type="text/javascript">
            $(document).ready(function() {
            if ($("#CreateFixDiv").children().length > 0) {
            $("#CreateFixDiv").show();
                }
            });
            </script>

