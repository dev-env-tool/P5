@model P5WebApp.Models.ViewModels.CarViewModel
@using P5WebApp.Models.Entities


@{
    Layout = "_Layout";
    var fixes = ViewBag.Fixes as List<Fix>;
}


<div class="row">
    <h1 class="mb-3 col-4 offset-md-4">
        Création d'une voiture
    </h1>
    <div style="white-space:pre-line">
        <h1></h1>
    </div>
    <form method="post">
        <input type="hidden" name="CarId" value="@Model.CarId" />
        <div class="mb-3 col-4 offset-md-4">
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Marque*':</label>
            </div>
            <select asp-for="CarBrandId" class="form-select col-12" asp-items="@(new SelectList(Model.CarBrands, "BrandId", "BrandName"))"></select>
            <span asp-validation-for="CarBrandId"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Modèle*':</label>
            </div>
            <select asp-for="CarModelId" class="form-select col-12" asp-items="@(new SelectList(Model.CarModels, "Id", "Name"))"></select>
            <span asp-validation-for="CarModelId"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Finition*':</label>
            </div>
            <select asp-for="CarFinishTypeId" class="form-select col-12" asp-items="@(new SelectList(Model.FinishTypes, "FinishTypeId", "FinishTypeName"))"></select>
            <span asp-validation-for="CarFinishTypeId"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Numéro de plaque*:</label>
            </div>
            <input asp-for="CarVinCode" class="form-control col-12" />
            <span asp-validation-for="CarVinCode"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Année de production*:</label>
            </div>
            <input asp-for="CarYear" type="text" id="txtDate" class="form-control col-12" date="@Model.CarYear" />
            <span asp-validation-for="CarYear"></span>
            <label class="date"></label>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Date d'achat*':</label>
            </div>
            <input asp-for="CarBuyDate" type="text" id="txtDate2" class="form-control col-12" date="@Model.CarBuyDate" />
            <span asp-validation-for="CarBuyDate"></span>
            <label class="date"></label>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Prix d'achat*':</label>
            </div>
            <input asp-for="CarBuyPrice" class="form-control col-12">
            <span asp-validation-for="CarBuyPrice"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>

            
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div>
                <div class="mb-3 col-8">
                    <table class="table table-bordered table-striped table-sm">
                        <thead>
                            <tr>
                                <th>
                                    <label>Réparation</label>
                                </th>
                                <th>
                                    <label>Date</label>
                                </th>
                                <th>
                                    <label>Coût</label>
                                </th>
                                <th>
                                    <label>Modifier</label>
                                </th>
                                <th>
                                    <label>Supprimer</label>
                                </th>
                            </thead>
                            <tbody>
      
                                @foreach (var f in ViewBag.Fixes)
                                {

                                    <tr>
                                        <td>
                                            @(f.FixDescription)
                                        </td>
                                        <td>
                                            @(f.FixDate)
                                        </td>
                                        <td>
                                            @(f.FixCost)
                                        </td>
                        
                                        <td>
                                            <form id="@(f.FixId)" asp-action="Edit" asp-controller="Fix" method="get">
                                                <input type="hidden" name="Id" value=@(f.FixId) />
                                                <button type="submit" class="btn-custom btn btn-danger">
                                                    Modifier
                                                </button>
                                            </form>
                                        </td>
                                        <td>
                        
                                            <form id="@(f.FixId)" asp-action="Delete" asp-controller="Fix" method="post">
                                                <input type="hidden" name="Id" value=@(f.FixId) />
                                                <button type="submit" class="btn-custom btn btn-danger">
                                                    Supprimer
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }



                            </tbody>
                        </table>
                    </div>
                    <a class="btn btn-primary btn-custom" asp-controller="Fix" asp-action="Create">Créer une réparation
                        <input type="hidden" name="Id" value=@(Model.CarBrandId) />
                    </a>

                </div>
                <div style="white-space:pre-line">
                    <h1></h1>
                </div>
                <div class="row">
                    <button type="submit" class="btn btn-custom col-12">Créer une voiture</button>
                </div>
            </div>
        </form>
    </div>
    <div style="white-space:pre-line">
        <h1></h1>
    </div>

   

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
            <script type="text/javascript">
                $(function(){
                $("#txtDate").datepicker({format:"dd/mm/yyyy"});
                });
                $(function(){
                $("#txtDate2").datepicker({format:"dd/mm/yyyy"});
                });
            
            </script>

        }
    }