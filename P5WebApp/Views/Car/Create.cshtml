        <script type="text/javascript">
            $(document).ready
            (
            function()
            {
            $('#CarBrandId').change(function() {
            var selectedIds = $(this).val();
            var url = '@Url.Action("GetCarModelList", "Car")';

            if (!selectedIds || selectedIds.length === 0) {
            console.log('Selected Ids :', selectedIds);
            $('#CarModelId').empty().prop('disabled', true);
            return;
            }

            $('#CarModelId').prop('disabled', false);

            $.ajax({
            url: url,
            data: { id: selectedIds },
            traditional: true,
            dataType: 'json',
            
            success: function(data) {
            console.log('data : ', data);
            $('#CarModelId').empty();
            $('#CarModelId').append($('<option>', {
            value: '',
            text: '-- Choisissez un modèle --'
            }));
            $.each(data, function(index, model) {
            $('#CarModelId').append($('<option>',{
            // here Write id and name (instead of Id and Name as in the Controller) as here values are new anonymous values.
            value: model.id,
            text: model.name
            }));
            });
            },
            error: function()
            {
            alert('Erreur : les modèles ne sont pas récupérés.');
            $('#CarModelId').empty().prop('disabled', true);
            }
            });
            });
            }
            );
        </script>



        <script type="text/javascript">
            $(document).ready
            (
            function()
            {
            // $('#CarModelId').change(function() 
            $(document).on('change', '#CarBrandId, #CarModelId', function(){
            var selectedIds = $(this).val();
