@model P5WebApp.Models.ViewModels.CarViewModel
@using P5WebApp.Models.Entities


@{
    Layout = "_Layout";

}

<form asp-action="Submit" method="post">
    <div class="form-group">
        <label asp-for="CarYear"></label>
        <input asp-for="CarYear" class="form-control" type="date" />
        <span asp-validation-for="CarYear" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CarBuyDate"></label>
        <input asp-for="CarBuyDate" class="form-control" type="date" />
        <span asp-validation-for="CarBuyDate" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-custom col-12">Créer une voiture</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



   


            