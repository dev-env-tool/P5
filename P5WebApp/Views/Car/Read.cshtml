@model P5WebApp.Models.ViewModels.CarViewModel
@using P5WebApp.Models.Entities


@{
    Layout = "_Layout";
}


<div class="row">
    <h1 class="mb-3 col-4 offset-md-4">
        Détails de la voiture
    </h1>
    <div style="white-space:pre-line">
        <h1></h1>
    </div>
    <div class="mb-3 col-4 offset-md-4">
        <div style="white-space:pre-line">
            <h1></h1>
        </div>
        @if (Model.CarDateSold != null)
        {
            <div class="mb-3 col-8">
                <label>Cette voiture a été vendue le : </label>
            </div>
            <label for="CarDateSold" class="bg-danger form-control col-12">@Model.CarDateSold</label>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
        }
        <div class="mb-3 col-8">
            <label>Photo :</label>
        </div>
        <img src="@Url.Content($"~/{@Model.PhotoPath}")" alt="@Model.CarBrandName / @Model.CarModelName" height="280" width="400" />
        <div style="white-space:pre-line">
            <h1></h1>
        </div>
        <div class="mb-3 col-8">
            <label>Marque :</label>
        </div>
        <label for="CarBrandName" class="form-control col-12">@Model.CarBrandName</label>
        <div style="white-space:pre-line">
            <h1></h1>
        </div>
        <div class="mb-3 col-8">
            <label>Modèle :</label>
        </div>
        <label for="CarModelName" class="form-control col-12">@Model.CarModelName</label>
        <div style="white-space:pre-line">
            <h1></h1>
        </div>
        <div class="mb-3 col-8">
            <label>Prix de vente :</label>
        </div>
        <label for="CarSellingPrice" class="form-control col-12">@Model.CarSellingPrice</label>
        <div style="white-space:pre-line">
            <h1></h1>
        </div>
        <div class="mb-3 col-8">
            <label>Finition :</label>
        </div>
        <label for="CarFinishTypeName" class="form-control col-12">@Model.CarFinishTypeName</label>
        <div style="white-space:pre-line">
            <h1></h1>
        </div>
        <div class="mb-3 col-8">
        <label>Année de production :</label>
        </div>
        <label for="CarFinishTypeName" class="form-control col-12">@Model.CarYear</label>
        <div style="white-space:pre-line">
            <h1></h1>
        </div>
        <div class="mb-3 col-8">
            <label>Description :</label>
        </div>
        <label for="CarDescription" class="form-control col-12">@Model.CarDescription</label>
        <div style="white-space:pre-line">
            <h1></h1>
        </div>
        <div class="mb-3 col-8">
        <label>Date de disponibilité :</label>
        </div>
        <label for="CarAddAvailabilityDate" class="form-control col-12">@Model.CarAddAvailabilityDate</label>
        <div style="white-space:pre-line">
            <h1></h1>
        </div>

        <div class="mb-3 col-12">
         
                @if (Model.CarFixesViewModelList != null && Model.CarFixesViewModelList.Count() > 0)
                {
                <h5>Réparations :</h5>        
                <div style="white-space:pre-line">
                <h1></h1>
                </div>
                    @for (int i = 0; i < Model.CarFixesViewModelList.Count; i++)
                    {
                            
                            @Html.HiddenFor(m => m.CarFixesViewModelList[i].FixId)
                            @Html.HiddenFor(m => m.CarFixesViewModelList[i].AssociatedCarId)
                            <div class="mb-3 col-8">
                                <label>Description de la réparation :</label>
                            </div>
                            @Html.TextBoxFor(m => m.CarFixesViewModelList[i].FixDescription, new { @class = "form-control col-8 bg-white", disabled = "disabled"})
                            <div style="white-space:pre-line">
                                <h1></h1>
                            </div>
                            <div class="mb-3 col-8">
                                <label>Date de la réparation :</label>
                            </div>
                            @Html.TextBoxFor(m => m.CarFixesViewModelList[i].FixDate, new { @class = "form-control col-8 bg-white", disabled = "disabled" })
                            <div style="white-space:pre-line">
                                <h1></h1>
                            </div>

                            <div class="mb-3 col-8">
                                <label>Coût de la réparation :</label>
                            </div>
                            @Html.TextBoxFor(m => m.CarFixesViewModelList[i].FixCost, new { @class = "form-control col-8 disabled bg-white", disabled = "disabled" })
                            <div style="white-space:pre-line">
                                <h1></h1>
                            </div>
                               
                    }
                }
            
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

