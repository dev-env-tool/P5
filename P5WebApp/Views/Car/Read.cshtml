</div>
   

        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
                <script type="text/javascript">
                    $(function(){
                    $("#txtDate").datepicker({format:"dd/mm/yyyy"});
                    });
                    $(function(){
                    $("#txtDate2").datepicker({format:"dd/mm/yyyy"});
