@model P5WebApp.Models.ViewModels.CarViewModel
@using P5WebApp.Models.ViewModels
@using P5WebApp.Models.Entities

@{
    Layout = "_Layout";
    var brands = ViewBag.Brands as List<Brand>;
    var carModels = ViewBag.CarModels as List<CarModel>;
    var finishTypes = ViewBag.FinishTypes as List<FinishType>;
}


<div class="row">
    <h1 class="mb-3 col-4 offset-md-4">
        Modification d'une voiture
    </h1>
    <div style="white-space:pre-line">
        <h1></h1>
    </div>
    <form method="post">
        <input type="hidden" name="CarId" value="@Model.CarId" />
        <div class="mb-3 col-4 offset-md-4">
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Marque*':</label>
            </div>

            <div class="form-label " itemtype=" @string.Join(",", brands.Where(b => Model.CarBrandId.Equals(b.BrandId)).Select(b => b.BrandName))">

                    @string.Join(",", brands.Where(b => Model.CarBrandId.Equals(b.BrandId)).Select(b => b.BrandName));

            </div>




            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Modèle*':</label>
            </div>
            <td>
                @string.Join(",", carModels.Where(cm => Model.CarModelId.Equals(cm.Id)).Select(cm => cm.Name));
            </td>
            <select asp-for="CarModelId" class="form-select col-12" asp-items="@(new SelectList(Model.CarModels, "Id", "Name"))"></select>
            <span asp-validation-for="CarModelId"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Finition*':</label>
            </div>
            <td>
                @string.Join(",", finishTypes.Where(f => Model.CarFinishTypeId.Equals(f.FinishTypeId)).Select(f => f.FinishTypeName));
            </td>
            <select asp-for="CarFinishTypeId" class="form-select col-12" asp-items="@(new SelectList(Model.FinishTypes, "FinishTypeId", "FinishTypeName"))"></select>
            <span asp-validation-for="CarFinishTypeId"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Numéro de plaque*:</label>
            </div>
            <input asp-for="CarVinCode" class="form-control col-12" />
            <span asp-validation-for="CarVinCode"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Année de production*:</label>
            </div>
            <input asp-for="CarYear" type="text" id="txtDate" class="form-control col-12" date="@Model.CarYear" />
            <span asp-validation-for="CarYear"></span>
            <label class="date"></label>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Date d'achat*':</label>
            </div>
            <input asp-for="CarBuyDate" type="text" id="txtDate2" class="form-control col-12" date="@Model.CarBuyDate" />
            <span asp-validation-for="CarBuyDate"></span>
            <label class="date"></label>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Prix d'achat*':</label>
            </div>
            <input asp-for="CarBuyPrice" class="form-control col-12">
            <span asp-validation-for="CarBuyPrice"></span>

            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="row">
                <button type="submit" class="btn btn-custom col-12">Modifier</button>
            </div>
        </div>
    </form>
</div>
<div>
    <table class="table table-bordered table-striped table-sm">
        <thead>
            <tr>
                <th>
                    <label>Réparation</label>
                </th>
                <th>
                    <label>Date</label>
                </th>
                <th>
                    <label>Coût</label>
                </th>
                <th>
                    <label>Modifier</label>
                </th>
                <th>
                    <label>Supprimer</label>
                </th>
            </thead>
            <tbody>
      



