@model P5WebApp.Models.ViewModels.FinishTypeViewModel


@{
    Layout = "_Layout";
}


<div class="row">
    <h1 class ="mb-3 col-4 offset-md-4">
        Création d'un modèle </h1>
    <div style="white-space:pre-line">
        <h1></h1>
    </div>
    <form method="post">
        <div class="mb-3 col-4 offset-md-4">
            <div class="mb-3 col-8">
                <label>Nom de la finition*:</label>
            </div>
            <input asp-for="FinishTypeName" class="form-control col-12" /><span asp-validation-for="FinishTypeName"></span>
            <div style="white-space:pre-line">
            <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Marques associées à la finition*:</label>
            </div>
            @* <select asp-for="AssociatedBrandsIds" multiple="multiple" class="form-select col-12" name="AssociatedBrandsIds" asp-items="@(new MultiSelectList(Model.Brands, "BrandId", "BrandName"))"></select> *@
            <select asp-for="AssociatedBrandsIds" class="form-select" id="AssociatedBrandsIds" multiple="multiple" asp-items="@(new MultiSelectList(Model.Brands, "BrandId", "BrandName"))"></select>
            <span asp-validation-for="AssociatedBrandsIds"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="mb-3 col-8">
                <label>Modèles associés à la finition:</label>
            </div>
            @* <select asp-for="AssociatedCarModelIds" multiple="multiple" class="form-select col-12" name="AssociatedCarModelIds" asp-items="@(new MultiSelectList(Model.CarModels, "Id", "Name"))"></select> *@
            <select asp-for="AssociatedCarModelIds" class="form-select" id="AssociatedCarModelIds" multiple="multiple" disabled="disabled"></select>
            <span asp-validation-for="AssociatedCarModelIds"></span>
            <div style="white-space:pre-line">
                <h1></h1>
            </div>
            <div class="row">
                <button type="submit" class="btn btn-custom col-12">Créer</button>
            </div>
        </div>
    </form>
</div>






@section Scripts 
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");


        <script type="text/javascript">
            $(document).ready(function() {
            $('#AssociatedBrandsIds').change(function() {
            var selectedIds = $(this).val();
            var url = '@Url.Action("GetCarModelList", "FinishType")';

            if (!selectedIds || selectedIds.length === 0) {
            console.log('Selected Ids :', selectedIds);
            $('#AssociatedCarModelIds').empty().prop('disabled', true);
            return;
            }

            $('#AssociatedCarModelIds').prop('disabled', false);

            $.ajax({
            url: url,
            data: { id: selectedIds },
            traditional: true,         
            dataType: 'json',
            
            
            
            success: function(data) {
                console.log('data : ', data);
            $('#AssociatedCarModelIds').empty();
            $.each(data, function(i, model) {
            $('#AssociatedCarModelIds').append($('<option>', {
            value: model.Id,
            text: model.Name
            }));
            });
            },
            error: function() {
            alert('Erreur lors de la récupération des modèles.');
            $('#AssociatedCarModelIds').empty().prop('disabled', true);

            }
            });
            });
            });
        </script>
























