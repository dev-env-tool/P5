@using P5WebApp.Models.ViewModels
@using P5WebApp.Models.Entities

@Html.ValidationSummary()


@model IEnumerable<P5WebApp.Models.ViewModels.FinishTypeViewModel>

@{
    ViewData["Title"] = "Gestion des finitions (administrateur)";
    Layout = "_Layout";
    var brands = ViewBag.Brands as List<Brand>;
    var carmodels = ViewBag.CarModels as List<CarModel>;
}

<h1>Gestion des finitions</h1>
<div style="white-space:pre-line">
    <h1></h1>
</div>
<a class="btn btn-primary btn-custom" asp-controller="FinishType" asp-action="Create">Créer</a>
<br />
<div style="white-space:pre-line">
    <h1></h1>
</div>
<div id="panel-body">
    <table class="table table-bordered table-striped table-sm">
        <thead>
            <tr>
                <th>
                    <label>Finition</label>
                </th>
                <th>
                <label>Marques associées</label>
                </th>
                <th>
                <label>Modèles associés</label>
                </th>
                <th>
                    <label>Modifier</label>
                </th>
                <th>
                    <label>Supprimer</label>
                </th>
        </thead>
        <tbody>


                       
            



            @foreach (FinishTypeViewModel f in Model)
            {
                <tr>
                    <td>@f.FinishTypeName</td>

                    <td>
                        @string.Join(",", brands.Where(b => f.AssociatedBrandsIds.Contains(b.BrandId)).Select(b => b.BrandName))
                    </td>
                        
                    <td>
                        @string.Join(",", carmodels.Where(c => f.AssociatedCarModelIds.Contains(c.Id)).Select(c => c.Name))

                    <td>
                        
                            <form id="@f.FinishTypeId" asp-action="Edit" asp-controller="FinishType" method="get">
                                <input type="hidden" name="id" value="@f.FinishTypeId" />
                                <button type="submit" class="btn-custom btn btn-danger">Modifier
                                </button>
                            </form>
                    </td>
                    <td>
                        
                            <form id="@f.FinishTypeId" asp-action="Delete" asp-controller="FinishType" method="post">
                            <input type="hidden" name="id" value="@f.FinishTypeId" />
                            <button type="submit" class="btn btn-danger">Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div style="white-space:pre-line">
        <h1></h1>
    </div>

</div>
@section Scripts {
    <script src="@Url.Content("~/js/test.js")"></script>
}