@page
@using Microsoft.AspNetCore.Identity
@model P5WebApp.Areas.Identity.Pages.Account.LoginModel


@{
    ViewData["Title"] = "";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-4 offset-md-4">
        <h1>Express Voitures</h1>
        <div style="white-space:pre-line">
            <h1></h1>
        </div>
        <section>
            <form id="account" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    Email <input type="email" name="Input.Email" class="form-control" value="votre@email.com" />
                </div>
                <div class="form-floating mb-3">
                    Mot de passe <input type="password" name="Input.Password" class="form-control" value="" />
                </div>


                <div style="white-space:pre-line">
                </div>
                <div class="btn-group">
                    <div class="col-md-10">
                        <button id="login-submit" type="submit" class="float-lg-start w-80 btn btn-custom">Se connecter</button>
                    </div>
                    <div class="text">ou</div>
                    <div class="col-md-11">
                        <button asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="float-lg-end btn btn-custom">S'inscrire</button>
                    </div>
                </div>
            </form>
        </section>
    </div>
    <div class="col-md-6 col-md-offset-2">
        <section>
            
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div>

                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            <p>
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                                }
                            </p>
                        </div>
                    </form>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/js/test.js")"></script>
    <partial name="_ValidationScriptsPartial" />
}
