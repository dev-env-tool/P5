@page
@using Microsoft.AspNetCore.Identity
@model P5WebApp.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "";
}

<h2>@ViewData["Title"]</h2>


<div class="container">
    <div class="row">
        <div class="col-md-4 offset-md-4">
            <section>
                <form id="account" method="post">
                    <h2>Express Voitures</h2>
                    <div style="white-space:pre-line"> 
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </div>
                        <h5>Adresse email</h5>
                        <div class="form-floating mb-1">
                            <input asp-for="Input.Email" class="form-control " autocomplete="username" aria-required="true" />
                            <label asp-for="Input.Email" class="form-label"></label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        
                    </div>
                    <h5>Mot de passe</h5>
                    <div class="form-floating mb-1">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                        <label asp-for="Input.Password" class="form-label"></label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div style="white-space:pre-line">
                    </div>
                    <div class="btn-group">
                        <div class="col-md-10">
                            <button id="login-submit" type="submit" class="float-lg-start w-80 btn btn-custom">Se connecter</button>
                        </div>
                        <div class="text">ou</div>
                        <div class="col-md-11">
                            <button asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="float-lg-end btn btn-custom">S'inscrire</button>
                        </div>
                    </div>

                </form>
            </section>
        </div>
    </div> 
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
